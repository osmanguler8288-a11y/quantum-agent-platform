.env
__pycache__/
*.pyc
logs/
doc/
# Docker 卷（运行时数据，不进 git）
volumes/

# SQLite 运行时数据库（工具库元数据 + 调用埋点）
*.db
*.db-wal
*.db-shm
*.db-journal

# 本地 AI 工具的工作目录（含二进制路径与工具自身记忆），非项目源码
.workbuddy/

# EqV2 工具的运行期产物（优化后结构 / 轨迹 CSV / 原始 JSON），非源码
backend/data/eqv2/

# 用户上传的分子结构附件（解析后的规范 XYZ），非源码
# ⚠️ 必须显式写目录规则：.xyz 不在下面的量化计算残留列表里
backend/data/attachments/
backend/data/descriptors/

# Go 网关构建产物（start-dev.ps1 会自动编译）
# 注意: backend/auth/auth 是历史上提交过的 macOS ARM64 二进制，已在版本控制中，
#       需要 git rm --cached 才能停止跟踪（.gitignore 对已跟踪文件无效）
backend/auth/auth.exe
backend/auth/auth
# go build 覆盖**正在运行**的二进制时，会把旧的那个改名成 auth.exe~ 留在原地
backend/auth/auth.exe~

# Gaussian / 量化计算测试残留
*.gjf
*.log
*.chk
*.fchk
*.out
*.wfn
*.wfx
