# LLM
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-key-here

# Embedding（硅基流动）
EMBED_MODEL=BAAI/bge-large-zh-v1.5
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_API_KEY=sk-your-key-here

# MySQL（Go 认证服务，Docker 部署不用改）
MYSQL_DSN=root:quantum123@tcp(127.0.0.1:3306)/quantum_auth?parseTime=true

# 本地开发跳过 SSO 认证（true=跳过，使用固定用户 local_dev；生产环境务必设为 false）
SKIP_AUTH=true

# JWT 密钥（生产环境请换成随机长字符串）
JWT_SECRET=change-me-in-production-use-a-long-random-string

# 后端地址（Go 认证网关转发目标，Docker 部署不用改）
BACKEND_URL=http://localhost:8000

# Redis（Docker 部署不用改）
REDIS_HOST=localhost
REDIS_PORT=6379

# Milvus（Docker 部署不用改）
MILVUS_HOST=localhost
MILVUS_PORT=19530
# 小内存 Linux 部署可使用 Milvus Lite（需安装 milvus-lite）；留空使用远程服务。
# QAP_MILVUS_URI=/app/data/vectors/milvus.db

# RAG
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=5

# Agent
MAX_RETRIES=3
MAX_STEPS=20

# ---------- EqV2 31M 机器学习势函数服务 ----------
# 公网推理服务：单点能/受力预测 + 异步几何优化。
# ⚠️ 明文 HTTP，Key 与坐标均不加密 —— 仅限可信网络使用。
# ⚠️ 服务端 2 vCPU / 3.5 GB、单 worker、单任务锁，且 Nginx 有限流；
#    突发请求会被打成 503。EQV2_MAX_RETRIES / EQV2_POLL_INTERVAL 不要调小。
#
# ⚠️ 注意 .env 的加载规则：config/settings.py 的 load_dotenv() 只会加载它
#    从 backend/config/ 向上找到的**第一个** .env。一旦在 backend/ 下创建了
#    .env（README 的 `cp .env.example .env` 流程、或 Docker 的 env_file），
#    仓库根目录的 .env 会被**整体屏蔽**。所以两处都要保留这份 EqV2 配置。
EQV2_API_BASE_URL=http://139.196.11.38:8888
EQV2_API_KEY=your-eqv2-api-key-here
EQV2_TIMEOUT=180
EQV2_RELAX_TIMEOUT=1800
EQV2_POLL_INTERVAL=8
EQV2_MAX_RETRIES=4
EQV2_MAX_ATOMS=200

# ---------- 用户上传的分子结构附件 ----------
# 上传的结构文件解析成规范 XYZ 后落在 data/attachments/，再把路径交给 Planner。
# 留空则用 backend/data/attachments/（基于 __file__ 推导的绝对路径）。
# 该目录已在 .gitignore 中，且**没有自动清理机制**，需要时手工删。
# ATTACHMENT_DATA_DIR=
# 附件文本上限（字节），默认 1MB
ATTACHMENT_MAX_BYTES=1048576

# Multiwfn 描述符分析：共用 EQV2_API_BASE_URL / EQV2_API_KEY。
# 原始 .fchk/.fch、可选 .out/.log 和任务记录独立保存，不做 XYZ 转换。
# DESCRIPTOR_DATA_DIR=
